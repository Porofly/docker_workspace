/// 비교 기준선(baseline) 설정: 순수 multicast 발견만 활성화
///
/// 목적: router_config.json5 (multicast + gossip + access_control 토픽 격리)와
///       네트워크 트래픽/동작을 비교하기 위한 최소 설정.
///
/// router_config.json5 대비 차이점:
///   - scouting.gossip 제거      → multicast 기반 발견만 사용
///   - access_control 블록 제거  → 외부 인터페이스 토픽 격리 없음
///                                 (fmu/**, rosout/**, tf/** 등도 드론 간에 전파됨)
{
  mode: "router",

  /// 드론 간 자동 발견 (같은 WiFi LAN)
  scouting: {
    multicast: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"], client: ["router"] },
      listen: true,
    },
  },
}
