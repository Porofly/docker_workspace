/// EXP4: TCP 대신 QUIC 사용
///
/// 변경점 (vs router_config.json5):
///   - listen.endpoints: "tcp/[::]:7447" → "quic/[::]:7447"
///   - transport.link.tls: 인증서 경로 명시 (QUIC는 TLS 필수)
///
/// 사전 작업:
///   호스트에서 인증서 생성:
///     cd zenoh_config/configs/exp4_quic && sudo bash generate_certs.sh
///   생성된 /etc/zenoh/certs/{ca.pem, server.key, server.pem} 을
///   호스트의 zenoh_config/certs/ 로 복사 (또는 스크립트 CERT_DIR을 수정).
///   컨테이너에서는 /root/zenoh_config/certs/ 로 접근됨 (volume mount).
///
/// 의도: QUIC(UDP+TLS1.3)는 무선 환경에서 패킷 손실 복원력이 우수하고
///       HoL blocking이 없음. TCP 대비 jitter/지연 변동 감소 기대.
{
  mode: "router",

  /// 드론 간 자동 발견 — baseline과 동일
  scouting: {
    multicast: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"], client: ["router"] },
      listen: true,
    },
    gossip: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"] },
    },
  },

  /// 토픽 격리 — baseline과 동일
  access_control: {
    enabled: true,
    default_permission: "allow",
    rules: [
      {
        id: "block_internal_topics_external",
        permission: "deny",
        flows: ["egress", "ingress"],
        messages: [
          "put", "delete",
          "declare_subscriber", "declare_queryable",
          "query", "reply",
          "liveliness_token", "liveliness_query", "declare_liveliness_subscriber",
        ],
        key_exprs: [
          "fmu/**",
          "**/fmu/**",
          "rosout/**",
          "**/rosout/**",
          "parameter_events/**",
          "**/parameter_events/**",
          "tf/**",
          "**/tf/**",
          "tf_static/**",
          "**/tf_static/**",
        ],
      },
    ],
    subjects: [
      {
        id: "external_ifaces",
        interfaces: ["wlP1p1s0", "eno1"],
      },
    ],
    policies: [
      {
        id: "policy_external_isolation",
        rules: ["block_internal_topics_external"],
        subjects: ["external_ifaces"],
      },
    ],
  },

  /// EXP4 변경 항목: QUIC listen + TLS 인증서
  listen: {
    endpoints: [
      "quic/[::]:7447",
    ],
  },

  transport: {
    link: {
      tls: {
        root_ca_certificate: "/root/zenoh_config/certs/ca.pem",
        listen_private_key: "/root/zenoh_config/certs/server.key",
        listen_certificate: "/root/zenoh_config/certs/server.pem",
        connect_private_key: "/root/zenoh_config/certs/server.key",
        connect_certificate: "/root/zenoh_config/certs/server.pem",
        enable_mtls: false,
        verify_name_on_connect: false,
      },
    },
  },
}
