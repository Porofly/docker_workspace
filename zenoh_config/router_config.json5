{
  mode: "router",

  /// 드론 간 자동 발견 (같은 WiFi LAN)
  scouting: {
    multicast: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"], client: ["router"] },
      listen: true,
    },
    gossip: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"] },
    },
  },

  /// 토픽 격리 정책:
  /// - default_permission: allow (내부 local 통신은 영향 받지 않음)
  /// - 외부 인터페이스(wlP1p1s0, eno1)에서는 아래 토픽만 차단
  ///   * fmu/**: PX4 내부 토픽
  ///   * rosout, parameter_events, tf/tf_static: ROS2 시스템 토픽
  ///   * 즉, swarm/** 등 사용자 정의 토픽만 드론 간 공유됨
  access_control: {
    enabled: true,
    default_permission: "allow",
    rules: [
      {
        id: "block_internal_topics_external",
        permission: "deny",
        flows: ["egress", "ingress"],
        messages: [
          "put", "delete",
          "declare_subscriber", "declare_queryable",
          "query", "reply",
          "liveliness_token", "liveliness_query", "declare_liveliness_subscriber",
        ],
        key_exprs: [
          "fmu/**",
          "**/fmu/**",
          "rosout/**",
          "**/rosout/**",
          "parameter_events/**",
          "**/parameter_events/**",
          "tf/**",
          "**/tf/**",
          "tf_static/**",
          "**/tf_static/**",
        ],
      },
    ],
    subjects: [
      {
        /// 외부 네트워크 인터페이스만 대상으로 함 (loopback 제외)
        id: "external_ifaces",
        interfaces: ["wlP1p1s0", "eno1"],
      },
    ],
    policies: [
      {
        id: "policy_external_isolation",
        rules: ["block_internal_topics_external"],
        subjects: ["external_ifaces"],
      },
    ],
  },
}
