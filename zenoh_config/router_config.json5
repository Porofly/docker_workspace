{
  mode: "router",

  /// 드론 간 자동 발견 (같은 WiFi LAN)
  scouting: {
    multicast: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"], client: ["router"] },
      listen: true,
    },
    gossip: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"] },
    },
  },

  /// 기본 격리 정책:
  /// - default_permission: deny (아무것도 안 쓴 것은 전부 차단)
  /// - 내부 lo 인터페이스: 모든 토픽 허용 (PX4 <-> ROS2 내부 통신)
  /// - 외부 wlP1p1s0/eno1 인터페이스: swarm/** 만 허용 (드론 간 공유 채널)
  access_control: {
    enabled: true,
    default_permission: "deny",
    rules: [
      /// 모든 토픽 허용
      {
        id: "allow_all",
        permission: "allow",
        flows: ["egress", "ingress"],
        messages: [
          "put", "delete",
          "declare_subscriber", "declare_queryable",
          "query", "reply",
          "liveliness_token", "liveliness_query", "declare_liveliness_subscriber",
        ],
        key_exprs: ["**"],
      },
      /// swarm/** 만 허용
      {
        id: "allow_swarm",
        permission: "allow",
        flows: ["egress", "ingress"],
        messages: [
          "put", "delete",
          "declare_subscriber", "declare_queryable",
          "query", "reply",
          "liveliness_token", "liveliness_query", "declare_liveliness_subscriber",
        ],
        key_exprs: ["swarm/**"],
      },
    ],
    subjects: [
      {
        /// 내부 loopback 인터페이스
        id: "internal_ifaces",
        interfaces: ["lo"],
      },
      {
        /// 외부 네트워크 인터페이스
        id: "external_ifaces",
        interfaces: ["wlP1p1s0", "eno1"],
      },
    ],
    policies: [
      {
        /// 내부 인터페이스: 모든 토픽 허용
        id: "policy_internal_all",
        rules: ["allow_all"],
        subjects: ["internal_ifaces"],
      },
      {
        /// 외부 인터페이스: swarm/** 만 허용
        id: "policy_external_swarm",
        rules: ["allow_swarm"],
        subjects: ["external_ifaces"],
      },
    ],
  },
}
