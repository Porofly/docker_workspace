/// EXP3: Batching time_limit 증가 (1ms → 10ms)
///
/// 변경점 (vs router_config.json5):
///   - transport.link.tx.queue.batching.time_limit: 1 → 10
///
/// 의도: back-pressure(네트워크 혼잡) 발생 시 작은 메시지들을 최대 10ms 동안
///       모아서 한 번에 전송. 패킷 수 감소, payload/패킷 증가, 평균 지연 약간 증가.
{
  mode: "router",

  /// 드론 간 자동 발견 — baseline과 동일
  scouting: {
    multicast: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"], client: ["router"] },
      listen: true,
    },
    gossip: {
      enabled: true,
      autoconnect: { router: ["router"], peer: ["router", "peer"] },
    },
  },

  /// 토픽 격리 — baseline과 동일
  access_control: {
    enabled: true,
    default_permission: "allow",
    rules: [
      {
        id: "block_internal_topics_external",
        permission: "deny",
        flows: ["egress", "ingress"],
        messages: [
          "put", "delete",
          "declare_subscriber", "declare_queryable",
          "query", "reply",
          "liveliness_token", "liveliness_query", "declare_liveliness_subscriber",
        ],
        key_exprs: [
          "fmu/**",
          "**/fmu/**",
          "rosout/**",
          "**/rosout/**",
          "parameter_events/**",
          "**/parameter_events/**",
          "tf/**",
          "**/tf/**",
          "tf_static/**",
          "**/tf_static/**",
        ],
      },
    ],
    subjects: [
      {
        id: "external_ifaces",
        interfaces: ["wlP1p1s0", "eno1"],
      },
    ],
    policies: [
      {
        id: "policy_external_isolation",
        rules: ["block_internal_topics_external"],
        subjects: ["external_ifaces"],
      },
    ],
  },

  /// EXP3 변경 항목
  transport: {
    link: {
      tx: {
        queue: {
          batching: {
            enabled: true,
            time_limit: 10,
          },
        },
      },
    },
  },
}
